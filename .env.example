# PRSpec environment variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Required: at least one LLM API key
GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# Azure AI Foundry (a Claude deployment in your own resource).
# Set LLM_PROVIDER=azure to use it. The endpoint is the deployment's Anthropic
# Messages URL (shown in the portal's Consume tab); the key is the resource key.
# AZURE_AI_API_KEY=your_azure_ai_key_here
# AZURE_AI_ENDPOINT=https://your-resource.services.ai.azure.com/anthropic/v1/messages
# AZURE_AI_DEPLOYMENT=claude-opus-4-8
# Optional: run the skeptic/verification rounds on a cheaper deployment
# (e.g. primary=Opus, verification=Sonnet). Falls back to AZURE_AI_DEPLOYMENT.
# AZURE_AI_VERIFY_DEPLOYMENT=your_cheaper_deployment_name

# Optional: override the default LLM provider (gemini, openai, or azure)
# LLM_PROVIDER=gemini

# Optional: GitHub token for higher API rate limits
# GITHUB_TOKEN=your_github_token_here
